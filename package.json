{
  "name": "pt-depiler",
  "private": true,
  "version": "0.0.6",
  "type": "module",
  "homepage": "https://github.com/pt-plugins/PT-depiler",
  "packageManager": "pnpm@12.10.1",
  "author": {
    "name": "Pt-Plugins",
    "url": "https://github.com/pt-plugins"
  },
  "maintainers": [
    {
      "name": "Rhilip",
      "url": "https://github.com/Rhilip"
    }
  ],
  "contributors": [
    {
      "name": "ronggang",
      "url": "https://github.com/ronggang"
    },
    {
      "name": "ted423",
      "url": "https://github.com/ted423"
    }
  ],
  "scripts": {
    "dev": "vite dev",
    "format": "prettier --list-different -w ./",
    "check": "vue-tsc --noEmit && tsx vite/checkSiteDefinition.ts",
    "check:site-definition": "tsx vite/checkSiteDefinition.ts",
    "build:dist": "vite build",
    "build:dist-firefox": "cross-env TARGET=firefox vite build",
    "build:watch": "vite build --watch --mode development --minify false",
    "action:upload_telegram": "tsx vite/sendToTgChannel.ts",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=23.7.0",
    "pnpm": ">=12.0.0"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@vueuse/components": "^15.0.0",
    "@vueuse/core": "^15.0.0",
    "@webext-core/job-scheduler": "^2.0.0",
    "@webext-core/messaging": "^4.0.0",
    "@webext-core/storage": "^2.0.0",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "es-toolkit": "^1.52.0",
    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "filesize": "^11.0.25",
    "idb": "^8.0.3",
    "konva": "^10.7.0",
    "nanoid": "^6.0.1",
    "p-queue": "^9.3.3",
    "parse-torrent": "^11.0.24",
    "pinia": "^4.0.3",
    "pinia-plugin-state-persistence": "^1.11.0",
    "search-query-parser": "^1.6.0",
    "sizzle": "^2.3.10",
    "url-join": "^5.0.0",
    "valid-filename": "^5.0.0",
    "vue": "^3.5.43",
    "vue-echarts": "^8.3.1",
    "vue-i18n": "^11.4.12",
    "vue-konva": "^4.0.1",
    "vue-router": "^5.3.1",
    "vuetify": "^4.2.2",
    "webdav": "^5.11.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@types/chrome": "^0.3.0",
    "@types/file-saver": "^2.0.7",
    "@types/git-rev-sync": "^2.0.2",
    "@types/node": "^26.6.3",
    "@types/parse-torrent": "^11.0.1",
    "@types/sizzle": "^2.3.10",
    "@vitejs/plugin-vue": "^6.0.9",
    "cross-env": "^10.1.0",
    "git-rev-sync": "^3.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^6.4.3",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vite-plugin-web-extension": "4.5.1",
    "vue-tsc": "^3.3.11"
  },
  "prettier": {
    "printWidth": 120,
    "semi": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "vueIndentScriptAndStyle": false,
    "endOfLine": "lf"
  },
  "lint-staged": {
    "*.{js,ts,json,vue,html,css,scss}": [
      "prettier --write "
    ]
  }
}
